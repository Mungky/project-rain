# =============================================================================
# Project Rain — Production Environment Variables
# =============================================================================
# Used by Coolify (backend) and Vercel (frontend) deployments.
#
# Coolify:  paste all BACKEND vars below into the project Environment Variables tab.
# Vercel:   set only NEXT_PUBLIC_* vars in the project Environment Variables tab.
#
# DO NOT commit the actual .env.production file — only this example.
# Generate secrets with:  openssl rand -hex 32
# =============================================================================

# --- Environment ---
ENVIRONMENT=production

# --- Backend (rain-api) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# --- Datastores (internal Docker network — names match docker-compose.yml services) ---
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DSN=postgresql+asyncpg://rain:CHANGE_ME_strong_random_password@postgres:5432/rain
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# --- MinIO (object storage on same VPS) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_random_access_key
MINIO_SECRET_KEY=CHANGE_ME_strong_random_secret
MINIO_SECURE=false
MINIO_BUCKET_UPLOADS=rain-uploads

# --- LLM Providers ---
# Ollama Cloud (recommended — matches kimi-k2.6:cloud, gemma4:31b-cloud defaults)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_DEFAULT_MODEL=kimi-k2.6:cloud
OLLAMA_KEEP_ALIVE_MINUTES=5
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EXTRACTION_MODEL=gemma4:31b-cloud

# Optional cloud providers (set keys to enable; leave empty to disable)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- CORS / Public URLs ---
FRONTEND_ORIGIN=https://rain.restard.org
BACKEND_ORIGIN=https://api.rain.restard.org

# --- Nimbus (Google Drive + Gmail) ---
# Run: python packages/db/scripts/google_oauth_setup.py to get OAuth tokens
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
NIMBUS_DRIVE_ROOT_FOLDER_ID=
GMAIL_SENDER=fikri.mmstaqim@gmail.com
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=fikri.mmstaqim@gmail.com

# --- Persona Default Models ---
DRIZZLE_DEFAULT_MODEL=kimi-k2.6:cloud
SHOWER_DEFAULT_MODEL=
STORM_DEFAULT_MODEL=

# --- Cache TTLs (seconds) ---
EMBEDDING_CACHE_TTL=604800
LLM_CACHE_TTL=3600
SESSION_TTL=86400

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Security ---
# Shared bearer token. Required for production. Generate:
#   openssl rand -hex 32
API_BEARER_TOKEN=

# Fernet key for encrypting provider API keys at rest in Postgres. Required
# for production. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# Skill safety — leave False unless you've sandboxed the runner.
ENABLE_PYTHON_EXECUTOR=false
ENABLE_SKILL_INSTALL=false

# =============================================================================
# Frontend (Vercel) — set these in Vercel project settings
# =============================================================================
NEXT_PUBLIC_API_BASE_URL=https://api.rain.restard.org
NEXT_PUBLIC_WS_URL=wss://api.rain.restard.org/ws
NEXT_PUBLIC_MINIO_HOSTNAME=api.rain.restard.org

# Must match API_BEARER_TOKEN above. Frontend bundles this so the browser
# can authenticate API requests; Vercel basic-auth still gates the page.
NEXT_PUBLIC_API_BEARER_TOKEN=
