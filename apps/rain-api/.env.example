# Environment Variables for Rain Backend
# Copy to .env and adjust accordingly

# --- LLM Providers ---
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Datastores ---
POSTGRES_DSN=postgresql+asyncpg://rain:rain@localhost:5432/rain
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=rain
MINIO_SECRET_KEY=rainminio

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=INFO

# --- Frontend ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Security ---
SESSION_SECRET_KEY=change-me-in-production

# --- Environment ---
ENVIRONMENT=development

# --- Ollama Settings ---
OLLAMA_DEFAULT_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_KEEP_ALIVE_MINUTES=5

# --- Cache TTLs (seconds) ---
EMBEDDING_CACHE_TTL=604800
LLM_CACHE_TTL=3600
SESSION_TTL=86400