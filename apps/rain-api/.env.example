# Environment Variables for Rain Backend
# Copy to .env and adjust accordingly

# --- LLM Providers ---
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Datastores ---
POSTGRES_DSN=postgresql+asyncpg://rain:rain@localhost:5432/rain
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=rain
MINIO_SECRET_KEY=rainminio

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=INFO

# --- Frontend ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Security ---
SESSION_SECRET_KEY=change-me-in-production

# --- Auth ---
# Password for the default admin account (run seed script after migration)
RAIN_ADMIN_PASSWORD=change-me-on-first-run

# --- Nimbus (Document Archive Agent) ---
# Path to Google Service Account JSON file (relative or absolute)
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID of the RAIN-ARCHIVE root folder in Google Drive
NIMBUS_DRIVE_ROOT_FOLDER_ID=
# Gmail sender for email notifications (your Gmail address)
GMAIL_SENDER=fikri.mmstaqim@gmail.com
# Gmail App Password (NOT your regular password — generate in Google Account > Security > App Passwords)
GMAIL_APP_PASSWORD=
# Admin email that receives notifications
ADMIN_EMAIL=fikri.mmstaqim@gmail.com
# Public URL of this backend (for approve/deny links in emails)
BACKEND_ORIGIN=http://localhost:8000

# --- Environment ---
ENVIRONMENT=development

# --- Ollama Settings ---
OLLAMA_DEFAULT_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_KEEP_ALIVE_MINUTES=5

# --- Cache TTLs (seconds) ---
EMBEDDING_CACHE_TTL=604800
LLM_CACHE_TTL=3600
SESSION_TTL=86400