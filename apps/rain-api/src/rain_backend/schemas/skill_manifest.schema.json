{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rain Skill Manifest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "runtime": {
      "type": "string",
      "enum": ["python3.11", "python3.12", "nodejs20"]
    },
    "entry": {
      "type": "string",
      "description": "Format: handler.py:handle"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "description": { "type": "string" },
          "required": { "type": "boolean" },
          "default": { "type": ["string", "number", "boolean", "array", "object", "null"] }
        },
        "required": ["type"]
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "network": { "type": "boolean", "default": false },
        "filesystem": { "type": "boolean", "default": false },
        "duration_seconds_max": { "type": "integer", "default": 30 }
      }
    }
  },
  "required": ["name", "version", "description", "runtime", "entry"]
}
