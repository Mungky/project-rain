# --- Project Rain Environment Variables ---
# Copy to .env and adjust accordingly.
# This file is the single source of truth for all components (Parent Agent owned).

# --- LLM Providers ---
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=                # Phase 2+
OPENAI_API_KEY=                   # Phase 2+
GOOGLE_API_KEY=                   # Phase 2+

# --- Datastores ---
POSTGRES_DSN=postgresql+asyncpg://rain:rain@localhost:5432/rain
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=rain
MINIO_SECRET_KEY=rainminio

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=INFO
OLLAMA_DEFAULT_MODEL=kimi-k2.6:cloud
OLLAMA_KEEP_ALIVE_MINUTES=5

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
FRONTEND_ORIGIN=http://localhost:3000

# --- Security ---
SESSION_SECRET_KEY=change-me-in-production

# --- Environment ---
ENVIRONMENT=development

# --- Cache TTLs (seconds) ---
EMBEDDING_CACHE_TTL=604800
LLM_CACHE_TTL=3600
SESSION_TTL=86400
