generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum message_role {
  user
  assistant
  system
  tool
}

enum document_status {
  uploading
  processing
  ready
  error
}

// ============================================================================
// Core Models
// ============================================================================

model User {
  id            String         @id @default(uuid()) @db.Uuid
  username      String         @unique(map: "uq_users_username") @db.VarChar(50)
  email         String?        @db.VarChar(255)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  conversations Conversation[]
  documents     Document[]
  preference    UserPreference?

  @@index([username], map: "ix_users_username")
  @@map("users")
}

model UserPreference {
  id                   String   @id @default(uuid()) @db.Uuid
  user_id              String   @unique(map: "uq_user_preferences_user_id") @db.Uuid
  custom_system_prompt String?  @db.Text
  user_context         String?  @db.Text
  api_keys             Json?    @default("{}")
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user                 User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_preferences")
}

model Conversation {
  id               String           @id @default(uuid()) @db.Uuid
  user_id          String           @db.Uuid
  title            String?          @db.VarChar(200)
  persona          String           @default("drizzle") @db.VarChar(20)
  auto_skills      Boolean          @default(true)
  enabled_skills   Json             @default("[]")
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?        @db.Timestamptz(6)
  user             User             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages         Message[]
  skill_executions SkillExecution[]

  @@index([user_id, created_at], map: "ix_conversations_user_id_created_at")
  @@map("conversations")
}

model Message {
  id                String       @id @default(uuid()) @db.Uuid
  conversation_id   String       @db.Uuid
  role              message_role
  content           String       @db.Text
  tokens_in         Int          @default(0)
  tokens_out        Int          @default(0)
  feedback          Int?
  reasoning_content String?      @db.Text
  attachments       Json?
  model             String?      @db.VarChar(200)
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  conversation      Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  documents         Document[]

  @@index([conversation_id, created_at], map: "ix_messages_conversation_id_created_at")
  @@map("messages")
}

// ============================================================================
// Phase 2+ Models
// ============================================================================

model Document {
  id                String          @id @default(uuid()) @db.Uuid
  user_id           String          @db.Uuid
  filename          String          @db.VarChar(255)
  mime              String          @db.VarChar(128)
  minio_key         String          @db.VarChar(512)
  qdrant_collection String          @default("documents") @db.VarChar(64)
  source_type       String          @default("manual") @db.VarChar(16)
  message_id        String?         @db.Uuid
  status            document_status @default(uploading)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  user              User            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  message           Message?        @relation(fields: [message_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([user_id], map: "ix_documents_user_id")
  @@index([message_id], map: "ix_documents_message_id")
  @@index([user_id, created_at], map: "ix_documents_user_id_created_at")
  @@index([status], map: "ix_documents_status")
  @@map("documents")
}

model Skill {
  id            String           @id @default(uuid()) @db.Uuid
  name          String           @db.VarChar(100)
  version       String           @db.VarChar(20)
  manifest_json Json
  docker_image  String?          @db.VarChar(255)
  installed_at  DateTime         @default(now()) @db.Timestamptz(6)
  enabled       Boolean          @default(true)
  created_at    DateTime         @default(now()) @db.Timestamptz(6)
  updated_at    DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  executions    SkillExecution[]

  @@unique([name, version], map: "uq_skills_name_version")
  @@index([enabled], map: "ix_skills_enabled")
  @@map("skills")
}

model SkillExecution {
  id              String        @id @default(uuid()) @db.Uuid
  skill_id        String        @db.Uuid
  conversation_id String?       @db.Uuid
  input           String        @db.Text
  output          String?       @db.Text
  duration_ms     Int?
  error           String?       @db.Text
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  skill           Skill         @relation(fields: [skill_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  conversation    Conversation? @relation(fields: [conversation_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([skill_id], map: "ix_skill_executions_skill_id")
  @@index([conversation_id], map: "ix_skill_executions_conversation_id")
  @@index([created_at], map: "ix_skill_executions_created_at")
  @@map("skill_executions")
}

model ContextEntry {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  title       String   @db.VarChar(200)
  content     String   @db.Text
  category    String?  @db.VarChar(100)
  subcategory String?  @db.VarChar(100)
  source_type String   @default("manual") @db.VarChar(50)
  source_id   String?  @db.VarChar(200)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([user_id], map: "ix_context_entries_user_id")
  @@index([category], map: "ix_context_entries_category")
  @@map("context_entries")
}

model Prompt {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(200)
  description String?  @db.Text
  content     String   @db.Text
  category    String?  @db.VarChar(100)
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("prompts")
}

model ModelCapabilityOverride {
  model_id     String   @id @db.VarChar(200)
  capabilities Json     @default("[]")
  display_name String?  @db.VarChar(200)
  tags         Json     @default("[]")
  notes        String?  @db.Text
  persona      String   @default("drizzle") @db.VarChar(20)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("model_capability_overrides")
}
